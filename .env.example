# Plantilla de variables de entorno. Copiala como ".env" y completá los valores.
# Este archivo SÍ se sube a git: no pongas secretos acá. El .env real nunca se sube.

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Django
# Una clave larga y aleatoria, distinta en cada entorno. Para generar una:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# True solo en desarrollo. En producción: no la pongas (o False)
DEBUG=True
# Dominios separados por comas. Desarrollo: 127.0.0.1,localhost · Producción: habiticos.com,www.habiticos.com
ALLOWED_HOSTS=127.0.0.1,localhost
# Solo en producción, con https:// (por ejemplo https://habiticos.com,https://www.habiticos.com)
CSRF_TRUSTED_ORIGINS=

# Recordatorios en el teléfono (Web Push): un par de claves propias del sitio.
# Se generan una sola vez y no se cambian (si cambian, hay que reactivar cada teléfono):
#   .venv/bin/python manage.py generar_claves_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Correo de contacto que aparece en /privacidad y /terminos (opcional)
CONTACTO_EMAIL=

# Solo en producción: la base PostgreSQL (la da Render/Railway). Sin esto se usa db.sqlite3
# DATABASE_URL=postgres://usuario:clave@servidor:5432/habiticos
